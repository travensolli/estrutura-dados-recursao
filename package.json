{
  "name": "sequencias-recursivas",
  "version": "1.4.0",
  "private": true,
  "description": "PRJ.ED.1: cálculo recursivo de Fatorial, Fibonacci e Tribonacci com e sem cache, comparação de desempenho e árvore de chamadas",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @sequencias/api --filter @sequencias/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && pnpm test:repo",
    "test:repo": "vitest run --config vitest.repo.config.ts",
    "e2e": "pnpm --filter @sequencias/web e2e",
    "cli": "tsx apps/cli/src/index.ts",
    "relatorio": "node --expose-gc --import tsx apps/api/src/relatorio/gerar.ts && prettier --write docs/resultados-benchmark.md docs/relatorio.html",
    "ci:local": "sh scripts/ci-local.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
