{
  "name": "@sequencias/api",
  "version": "1.4.0",
  "private": true,
  "description": "API Fastify: cálculo oficial, benchmarks em worker_threads e árvore de chamadas",
  "type": "module",
  "scripts": {
    "dev": "node --expose-gc --import tsx --watch src/servidor.ts",
    "start": "node --expose-gc dist/servidor.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@sequencias/contrato": "workspace:*",
    "@sequencias/nucleo": "workspace:*",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
